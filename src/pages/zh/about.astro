---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import page from '../../content/pages/zh/about.json'; import { withBase } from '../../paths.js';
---
<Base title={page.title} description="Sharon Miao 的专业背景与培训，目前在 Mind &amp; Body Garden Psychology 担任 Psychotherapist。" locale="zh" counterpart="/about/"><section class="page-hero"><p class="kicker">关于我</p><h1>{page.heading}</h1><p>{page.subheading}</p></section><section class="split portrait"><img src={withBase('/images/portrait-960.webp')} srcset={`${withBase('/images/portrait-480.webp')} 480w, ${withBase('/images/portrait-960.webp')} 960w`} sizes="(max-width: 800px) 85vw, 440px" width="960" height="960" loading="lazy" decoding="async" alt="苗秀云 Sharon Miao，LCSW 坐在海边"><div><p class="kicker">心理咨询师</p><h2>{page.name}</h2><p>{page.body}</p><p>{page.secondary}</p><p>我目前在 Mind &amp; Body Garden Psychology 担任 Psychotherapist。本网站仅用于个人专业介绍与心理健康教育，不提供临床服务。</p><p><a href="https://www.psychologytoday.com/profile/1274912">查看我的 Psychology Today 专业资料</a></p></div></section><section class="soft"><div class="section-head"><p class="kicker">培训与资质</p><h2>教育背景、执照与培训</h2></div><div class="credential-grid">{page.credentials.map(x=><article><h3>{x.title}</h3><p>{x.detail}</p></article>)}</div></section><section class="prose philosophy"><p class="kicker">我的理念</p><h2>我对疗愈的信念</h2>{page.philosophy.map(p=><p>{p}</p>)}</section><Cta locale="zh"/></Base>
