---
import settings from '../content/settings.json';
import SocialLinks from '../components/SocialLinks.astro';
import WebsiteNotice from '../components/WebsiteNotice.astro';
import SiteIdentity from '../components/SiteIdentity.astro';
import { withBase, withoutBase } from '../paths.js';
import '../styles/global.css'; import '../styles/content.css'; import '../styles/visual-match.css'; import '../styles/nav-fix.css'; import '../styles/faq-fix.css'; import '../styles/faq-help.css'; import '../styles/legal.css'; import '../styles/original-site.css';
interface Props { title: string; description?: string; locale?: 'en'|'zh'; counterpart?: string; robots?: string; }
const { title, description: suppliedDescription, locale='en', counterpart, robots='index,follow' } = Astro.props;
const path=withoutBase(Astro.url.pathname); const zh=locale==='zh'; const description=suppliedDescription||(zh?'Sharon Miao 的个人专业介绍与心理健康教育网站。':settings.tagline);
const nav=zh?[['/zh/','首页'],['/zh/about/','关于我'],['/zh/services/','关注领域'],['/zh/blog/','博客'],['/zh/faq/','常见问题'],['/zh/contact/','联系我']]:[['/','Home'],['/about/','About'],['/services/','Professional Interests'],['/blog/','Blog'],['/faq/','FAQ'],['/contact/','Contact Information']];
const languageHref=counterpart||(zh?path.replace(/^\/zh/,'')||'/':`/zh${path}`);
const canonical=new URL(withBase(path),Astro.site);
const alternate=new URL(withBase(languageHref),Astro.site);
---
<!doctype html><html lang={zh?'zh-CN':'en'}><head><meta charset="UTF-8"><meta name="google-site-verification" content="a9fe6Bs0s2Emo7Q7Ia667GDjp6_p30QtwauP2A_Y_w8"><meta name="viewport" content="width=device-width"><title>{title===settings.practiceName?title:`${title} | ${settings.practiceName}`}</title><meta name="description" content={description}><meta name="robots" content={robots}><link rel="canonical" href={canonical}><link rel="alternate" hreflang={zh?'zh-CN':'en'} href={canonical}><link rel="alternate" hreflang={zh?'en':'zh-CN'} href={alternate}><SiteIdentity path={path} locale={locale} title={title} description={description}/><link rel="alternate" hreflang="x-default" href={zh?alternate:canonical}><meta property="og:url" content={canonical}><meta property="og:site_name" content={settings.practiceName}><meta property="og:locale" content={zh?'zh_CN':'en_US'}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:image" content={new URL(withBase('/images/coast.jpg'),Astro.site)}><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"></head><body><a class="skip" href="#main">{zh?'跳至主要内容':'Skip to content'}</a>
<header class="site-header"><a class="brand" href={withBase(zh?'/zh/':'/')} aria-label={zh?'Reminiscence Cloud 中文首页':'Reminiscence Cloud home'}><img class="original-logo" src={withBase('/images/logo-original.png')} alt="Reminiscence Cloud" width="310" height="72"></a><div class="header-actions"><a class="language" href={withBase(languageHref)} lang={zh?'en':'zh-CN'}>{zh?'EN':'中文'}</a><button class="menu" aria-expanded="false" aria-controls="nav"><span>{zh?'菜单':'Menu'}</span></button></div><nav id="nav" aria-label={zh?'主导航':'Primary'}><ul>{nav.map(([href,label])=><li><a href={withBase(href)} aria-current={path===href?'page':undefined}>{label}</a></li>)}<li class="nav-language"><a href={withBase(languageHref)} lang={zh?'en':'zh-CN'}>{zh?'English':'中文'}</a></li></ul></nav></header>
<main id="main"><WebsiteNotice locale={locale}/><slot /></main>
<footer><div><a class="brand footer-brand" href={withBase(zh?'/zh/':'/')}><img class="original-logo" src={withBase('/images/logo-original.png')} alt="Reminiscence Cloud" width="310" height="72"></a><p>{zh?'Sharon Miao 的个人专业介绍与心理健康教育网站。':'Sharon Miao’s personal professional profile and mental health education.'}</p></div><div><p><strong>{zh?'导航':'Navigate'}</strong></p><p>{nav.slice(0,5).map(([href,label],i)=><><a href={withBase(href)}>{label}</a>{i<4?' · ':''}</>)}</p></div><div><p><strong>Sharon Miao · Psychotherapist</strong></p><p>Mind &amp; Body Garden Psychology</p><p>{zh?'临床问题与预约请联系诊所的官方渠道。':'For clinical inquiries and appointments, contact the clinic through its official channels.'}</p><SocialLinks /></div><div class="footer-legal"><a href={withBase(zh?'/zh/privacy-policy/':'/privacy-policy/')}>{zh?'网站隐私政策':'Website Privacy Policy'}</a></div><p class="copyright">© {new Date().getFullYear()} Reminiscence Cloud · Sharon Miao</p></footer>
<script is:inline>const b=document.querySelector('.menu'),n=document.querySelector('#nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o)});</script></body></html>
