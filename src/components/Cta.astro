---
import { withBase } from '../paths.js';
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
---
<section class="cta"><div class="cta-copy"><p class="kicker">{zh?'专业背景':'Professional background'}</p><h2>{zh?'认识 Sharon Miao':'Meet Sharon Miao'}</h2><p>{zh?'了解我的专业背景、培训与心理健康关注领域。我目前在 Mind & Body Garden Psychology 担任 Psychotherapist。':'Learn about my background, training, and professional interests. I currently work as a Psychotherapist at Mind & Body Garden Psychology.'}</p><a class="button" href={withBase(zh?'/zh/about/':'/about/')}>{zh?'关于我':'About Sharon'}</a></div><img class="cta-photo" src={withBase('/images/office-960.webp')} alt={zh?'阅读空间':'A reading space'} width="400" height="400" loading="lazy"></section>
