---
import Base from '../layouts/Base.astro';
import { withBase } from '../paths.js';
const { specialty, locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const page = specialty[locale];
---
<Base title={page.label} description={zh ? 'Sharon Miao 的专业关注领域，仅供一般教育与背景介绍。' : 'A professional interest of Sharon Miao, shared for general education and background.'} locale={locale} counterpart={`${zh ? '' : '/zh'}/${specialty.slug}/`}><section class="page-hero"><p class="kicker">{zh ? '专业关注领域' : 'Professional interests'}</p><h1>{page.label}</h1><p>{zh ? '这是我的专业关注领域之一，仅用于介绍背景，并非通过本网站提供的独立服务。临床服务问题请联系 Mind & Body Garden Psychology 的官方渠道。' : 'This is one of my professional interests, shared as background rather than a separate service offered through this website. For clinical services, contact Mind & Body Garden Psychology through its official channels.'}</p><a class="button" href={withBase(zh ? '/zh/blog/' : '/blog/')}>{zh ? '阅读教育文章' : 'Read educational articles'}</a></section></Base>
