---
import settings from '../content/settings.json';
import { withBase } from '../paths.js';
const { path, locale, title, description } = Astro.props;
const url = (value) => new URL(withBase(value), Astro.site).href;
const personId = url('/about/#sharon-miao');
const data = { '@context': 'https://schema.org', '@graph': [
{ '@type': 'Person', '@id': personId, name: 'Sharon Miao', alternateName: ['Xiuyun Miao', '苗秀云'], jobTitle: 'Psychotherapist', worksFor: { '@type': 'Organization', name: 'Mind & Body Garden Psychology' }, url: url('/about/'), image: url('/images/portrait.jpg'), sameAs: [settings.linkedinUrl] },
{ '@type': 'WebSite', '@id': url('/#website'), url: url('/'), name: settings.practiceName, description: settings.tagline, publisher: { '@id': personId }, inLanguage: ['en', 'zh-CN'] },
{ '@type': path.includes('/about/') ? 'ProfilePage' : 'WebPage', '@id': url(path)+'#webpage', url: url(path), name: title, description, inLanguage: locale === 'zh' ? 'zh-CN' : 'en', isPartOf: { '@id': url('/#website') } }
] };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, '\u003c')} />
